  "branchDiff": "diff --git a/src/money.js b/src/money.js\nindex ed96ecb..6b90c75 100644\n--- a/src/money.js\n+++ b/src/money.js\n@@ -3,10 +3,12 @@ const SYMBOLS = { USD: \"$\", EUR: \"€\", GBP: \"£\" };\n /** Format integer cents as a currency string, e.g. 123456 → \"$1,234.56\". */\n export function formatMoney(cents, currency = \"USD\") {\n   const symbol = SYMBOLS[currency] ?? `${currency} `;\n-  const whole = Math.trunc(cents / 100);\n-  const frac = String(Math.abs(cents % 100)).padStart(2, \"0\");\n+  const abs = Math.abs(cents);\n+  const sign = cents < 0 ? \"-\" : \"\";\n+  const whole = Math.trunc(abs / 100);\n+  const frac = String(abs % 100).padStart(2, \"0\");\n   const grouped = String(whole).replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\");\n-  return `${symbol}${grouped}.${frac}`;\n+  return `${sign}${symbol}${grouped}.${frac}`;\n }\n \n /** Parse \"$1,234.50\", \"1234.5\" or \"-$5\" into integer cents. */\ndiff --git a/test/basic.test.js b/test/basic.test.js\nindex 35c17fc..28cdee0 100644\n--- a/test/basic.test.js\n+++ b/test/basic.test.js\n@@ -6,6 +6,10 @@ test(\"formatMoney formats positive amounts\", () => {\n   assert.equal(L.formatMoney(123456), \"$1,234.56\");\n   assert.equal(L.formatMoney(5, \"EUR\"), \"€0.05\");\n });\n+test(\"formatMoney formats negative amounts\", () => {\n+  assert.equal(L.formatMoney(-500), \"-$5.00\");\n+  assert.equal(L.formatMoney(-5), \"-$0.05\");\n+});\n test(\"parseMoney parses common forms\", () => {\n   assert.equal(L.parseMoney(\"$1,234.50\"), 123450);\n   assert.equal(L.parseMoney(\"-$5\"), -500);\n"
